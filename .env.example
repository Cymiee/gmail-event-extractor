# Copy this to .env and fill in your values

# Your local timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
DEFAULT_TZ=Asia/Dubai

# Google Calendar ID to add events to ("primary" uses your default calendar)
CALENDAR_ID=primary

# How many emails to fetch per run
MAX_RESULTS=15

# Only create events with extraction confidence >= this (0.0 - 1.0)
MIN_CONFIDENCE=0.70
